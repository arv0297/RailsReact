#!/usr/bin/env bash
# Enforce Conventional Commits subject format and length.
# Tracked copy: install with `bin/setup-git-hooks` (or `scripts/install-git-hooks.sh`).

msg_file="$1"
# Strip comment lines to get the real message.
subject=$(grep -v '^[[:space:]]*#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n1)

# Allow merge/revert commits generated by git.
case "$subject" in
  Merge\ *|Revert\ *) exit 0 ;;
esac

# Reject empty subject.
if [ -z "$subject" ]; then
  echo "commit-msg: subject is empty. See .gitmessage for the step-by-step guide." >&2
  exit 1
fi

# Validate type(scope): summary (scope optional).
if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|refactor|perf|test|docs|build|ci|chore|revert)(\([^)]+\))?: .+'; then
  echo "commit-msg: subject must match '<type>(<scope>): <summary>'." >&2
  echo "  types: feat fix refactor perf test docs build ci chore revert" >&2
  echo "  (scope optional). See .gitmessage." >&2
  exit 1
fi

# Enforce subject length <= 50.
len=${#subject}
if [ "$len" -gt 50 ]; then
  echo "commit-msg: subject is $len chars (max 50): $subject" >&2
  exit 1
fi

# Reject leftover placeholder.
if printf '%s' "$subject" | grep -q '<TRACKING_ID>\|<type>\|<scope>\|<short imperative summary>'; then
  echo "commit-msg: subject still contains a placeholder. Replace it first." >&2
  exit 1
fi

exit 0
