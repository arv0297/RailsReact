#!/usr/bin/env bash
# Enforce Conventional Commits subject format and length.
# Tracked copy: install with `bin/setup-git-hooks`.

msg_file="$1"
# Strip comment lines to get the real message.
subject=$(grep -v '^[[:space:]]*#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n1)

# Allow merge/revert commits generated by git.
case "$subject" in
  Merge\ *|Revert\ *) exit 0 ;;
esac

# Reject empty subject.
if [ -z "$subject" ]; then
  echo "commit-msg: subject is empty. See .gitmessage for the step-by-step guide." >&2
  exit 1
fi

# Current branch (empty in detached HEAD).
branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)

# Split off an optional trailing branch tag: " (branch-name)".
main="$subject"
tag=""
if printf '%s' "$subject" | grep -Eq ' \([^)]+\)$'; then
  tag=$(printf '%s' "$subject" | sed -E 's/.* \(([^)]+)\)$/\1/')
  main=$(printf '%s' "$subject" | sed -E 's/ \([^)]+\)$//')
fi

# On a feature/hotfix branch the commit must end with " (<branch>)".
case "$branch" in
  feature/*|hotfix/*)
    if [ "$tag" != "$branch" ]; then
      echo "commit-msg: subject must end with ' ($branch)'." >&2
      exit 1
    fi
    ;;
esac

# Validate type(scope): summary on the main part (scope optional).
if ! printf '%s' "$main" | grep -Eq '^(feature|fix|refactor|perf|test|docs|build|ci|chore|revert)(\([^)]+\))?: .+'; then
  echo "commit-msg: subject must match '<type>(<scope>): <summary>'." >&2
  echo "  types: feature fix refactor perf test docs build ci chore revert" >&2
  echo "  (scope optional). See .gitmessage." >&2
  exit 1
fi

# Enforce subject length <= 50 on the main part (branch tag not counted).
len=${#main}
if [ "$len" -gt 50 ]; then
  echo "commit-msg: subject is $len chars (max 50, branch tag not counted): $main" >&2
  exit 1
fi

# Reject leftover placeholder (in the main part).
if printf '%s' "$main" | grep -q '<TRACKING_ID>\|<type>\|<scope>\|<short imperative summary>'; then
  echo "commit-msg: subject still contains a placeholder. Replace it first." >&2
  exit 1
fi

exit 0
